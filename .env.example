APP_URL=http://localhost:4173

# DataFast Website Settings. The public website ID is configured in app.js.
# The API key stays server-side and powers the live visitor count.
DATAFAST_API_KEY=df_your_website_api_key
# Only required when DATAFAST_API_KEY is an account token beginning with dft_.
# DATAFAST_WEBSITE_ID=your_datafast_internal_website_id

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# X Developer Portal -> Project/App -> Bearer Token
X_BEARER_TOKEN=your_x_api_bearer_token

DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
